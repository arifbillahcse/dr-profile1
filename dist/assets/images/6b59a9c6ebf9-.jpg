<style>
    /* বেস কার্ড এবং ইনফিনিট অ্যানিমেশন */
    .feature-card {
        background: #ffffff;
        border-radius: 20px;
        transition: all 0.4s ease;
        border-bottom: 4px solid transparent;
        z-index: 2;
    }

    /* Infinite Floating Animation */
    .infinite-float {
        animation: floatMotion 4s infinite ease-in-out;
    }

    @keyframes floatMotion {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0px); }
    }

    /* হোভারে অ্যানিমেশন পজ হবে এবং কার্ড হাইলাইট হবে */
    .feature-card:hover {
        animation-play-state: paused;
        transform: scale(1.03) !important;
        box-shadow: 0 20px 40px rgba(10, 45, 30, 0.1) !important;
        border-bottom-color: #198754;
    }

    /* আইকন সার্কেল */
    .icon-circle-custom {
        width: 60px; height: 60px;
        background: #f0fdf4;
        border-radius: 50%;
        color: #198754;
        transition: 0.4s ease;
    }

    .feature-card:hover .icon-circle-custom {
        background: #0a2d1e;
        color: #fff;
        transform: rotateY(360deg);
    }

    /* টেক্সট এবং ইন্ডিকেটর */
    .text-dark-green { color: #0a2d1e !important; }

    .card-indicator-premium {
        height: 4px; width: 40px;
        border-radius: 10px;
        transition: 0.4s;
    }

    .feature-card:hover .card-indicator-premium {
        width: 100%; /* হোভারে ফুল হয়ে যাবে */
        background: #ffb703 !important; /* গোল্ডেন টাচ */
    }

    .visually-hidden {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;
    }
</style>

    
