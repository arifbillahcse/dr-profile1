<style>
    /* Section Typography */
    .ls-2 {
        letter-spacing: 2px;
    }

    .divider-premium {
        width: 70px;
        height: 5px;
        background: #0a2d1e;
        border-radius: 10px;
    }

    .bg-success-light {
        background: rgba(25, 135, 84, 0.1);
    }

    /* Call Button Styling */
    .btn-premium-call {
        background: #0a2d1e;
        color: #fff !important;
        transition: 0.4s;
        border: none;
    }

    .btn-premium-call:hover {
        background: #198754;
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(25, 135, 84, 0.3);
    }

    /* Timeline Vertical Line */
    .process-timeline-wrapper::before {
        content: '';
        position: absolute;
        left: 16px;
        top: 0;
        width: 3px;
        height: 100%;
        background: linear-gradient(to bottom, #198754, #0a2d1e, transparent);
        z-index: 0;
    }

    /* Step Badges */
    .step-badge-outer {
        position: absolute;
        left: -50px;
        top: 5px;
        z-index: 2;
    }

    .step-badge-inner {
        width: 35px;
        height: 35px;
        background: #0a2d1e;
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        border: 3px solid #fff;
        transition: 0.4s;
    }

    /* Hover Effects */
    .process-item-new:hover .step-badge-inner {
        background: #ffb703;
        color: #000;
        transform: scale(1.1);
    }

    .process-content-card {
        transition: 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .process-content-card:hover {
        transform: translateX(8px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08) !important;
    }

    /* Pulse Icon for Appointment */
    .pulse-icon {
        animation: heartBeat 1.5s infinite;
    }

    @keyframes heartBeat {

        0%,
        100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.2);
        }
    }

    /* --- Responsive Adjustments --- */
    @media (max-width: 991.98px) {
        .order-lg-1 {
            order: 2;
        }

        /* মোবাইলে চেম্বার লোকেশন নিচে যাবে */
        .order-lg-2 {
            order: 1;
        }

        /* মোবাইলে প্রসেস টাইমলাইন উপরে আসবে */
        .sticky-lg-top {
            position: relative !important;
            top: 0 !important;
        }
    }

    @media (max-width: 767.98px) {
        .process-timeline-wrapper::before {
            left: 12px;
        }

        .step-badge-outer {
            left: -38px;
        }

        .step-badge-inner {
            width: 30px;
            height: 30px;
            font-size: 0.9rem;
        }

        .process-content-card:hover {
            transform: translateX(5px);
        }

        .display-5 {
            font-size: 2rem;
        }
    }
</style>

    
