<style>
    /* Section Setup */
    .video-gallery-area {
        position: relative;
        z-index: 1;
        padding: 60px 0;
    }

    /* Video Card & Hover */
    .video-card-pure {
        transition: 0.4s;
        border: 1px solid #f1f1f1;
    }

    .video-card-pure:hover {
        transform: scale(1.01);
        box-shadow: 0 15px 30px rgba(10, 45, 30, 0.1) !important;
    }

    /* Button Styling */
    .more-video-wrapper {
        position: relative;
        padding: 20px 0;
        animation: floatingBtn 3s infinite ease-in-out;
    }

    .btn-premium-video {
        display: inline-flex;
        align-items: center;
        background: linear-gradient(135deg, #0a2d1e 0%, #198754 100%);
        padding: 10px 10px 10px 30px;
        border-radius: 60px;
        color: #ffffff !important;
        text-decoration: none;
        font-weight: 800;
        font-size: 13px;
        letter-spacing: 1.5px;
        transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        box-shadow: 0 10px 25px rgba(10, 45, 30, 0.3);
    }

    .btn-icon-box {
        width: 42px;
        height: 42px;
        background: #ffb703;
        color: #000;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: 20px;
        position: relative;
        z-index: 2;
    }

    .pulse-ring {
        position: absolute;
        width: 100%;
        height: 100%;
        background: #ffb703;
        border-radius: 50%;
        z-index: -1;
        animation: ripple 2s infinite;
        opacity: 0.5;
    }

    @keyframes ripple {
        0% { transform: scale(1); opacity: 0.5; }
        100% { transform: scale(1.8); opacity: 0; }
    }

    /* Background Icons Animations */
    .video-bg-icon {
        position: absolute;
        color: #198754;
        opacity: 0.1;
        z-index: 1;
        pointer-events: none;
        font-size: 40px;
    }

    .v-icon-1 { top: 5%; left: 3%; animation: floatY 6s infinite ease-in-out; }
    .v-icon-2 { top: 12%; right: 4%; color: #0a2d1e; font-size: 55px; animation: floatY 8s infinite reverse ease-in-out; }
    .v-icon-3 { bottom: 8%; left: 5%; font-size: 50px; animation: floatY 7s infinite ease-in-out 1s; }
    .v-icon-4 { bottom: 15%; right: 6%; color: #0a2d1e; animation: floatY 9s infinite reverse ease-in-out; }

    @keyframes floatY {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-30px) rotate(10deg); }
    }

    @keyframes floatingBtn {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }

    /* Mobile Responsive */
    @media (max-width: 768px) {
        .video-bg-icon { font-size: 25px; opacity: 0.05 !important; }
        .btn-premium-video { padding: 8px 8px 8px 20px; font-size: 11px; }
        .btn-icon-box { width: 35px; height: 35px; }
    }
</style>
    
