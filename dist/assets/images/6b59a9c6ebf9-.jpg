        background: #ffffff;
        position: relative;
        padding: 3px;
        /* বর্ডারের পুরুত্ব নিয়ন্ত্রণ করে */
        z-index: 1;
        overflow: hidden;
        border-radius: 20px;
        /* Rounded-4 এর সাথে সামঞ্জস্যপূর্ণ */
    }

    /* রানিং এনিমেশন তৈরি করার জন্য ছদ্ম-উপাদান (Pseudo-element) */
    .help-section-wrapper::before {
        content: "";
        position: absolute;
        z-index: -2;
        left: -50%;
        top: -50%;
        width: 200%;
        height: 200%;
        background-color: #f1f1f1;
        /* বর্ডারের পেছনের কালার */
        background-repeat: no-repeat;
        background-size: 50% 50%, 50% 50%;
        background-position: 0 0, 100% 0, 100% 100%, 0 100%;
        /* এখানে ফুটারের গ্রিন এবং গোল্ডেন ইয়েলোর গ্রেডিয়েন্ট ব্যবহার করা হয়েছে */
        background-image: linear-gradient(#198754, #198754),
            linear-gradient(#ffb703, #ffb703),
            linear-gradient(#198754, #198754),
            linear-gradient(#ffb703, #ffb703);
        animation: rotate-border 4s linear infinite;
    }

    /* ভেতরের অংশটিকে সাদা রাখার জন্য */
    .help-section-wrapper::after {
        content: "";
        position: absolute;
        z-index: -1;
        left: 4px;
        top: 4px;
        width: calc(100% - 8px);
        height: calc(100% - 8px);
        background: white;
        border-radius: 16px;
    }

    @keyframes rotate-border {
        100% {
            transform: rotate(360deg);
        }
    }

    /* হোভার করলে এনিমেশন ফাস্ট হবে */
    .help-section-wrapper:hover::before {
        animation-duration: 2s;
    }

    /* Help Banner Base */
    .help-banner-premium {
        background: linear-gradient(135deg, #0a2d1e 0%, #154d35 100%);
        border-radius: 15px;
        z-index: 1;
        box-shadow: inset 0 0 50px rgba(0, 0, 0, 0.2);
    }

    /* Background Pulse Animation - এখন আরও গাঢ় করা হয়েছে */
    .pulse-bg {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 150%;
        height: 150%;
        background: radial-gradient(circle, rgba(255, 183, 3, 0.15) 0%, transparent 60%);
        transform: translate(-50%, -50%);
        z-index: -1;
        animation: bgPulse 6s infinite ease-in-out;
    }

    @keyframes bgPulse {

        0%,
        100% {
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.4;
        }

        50% {
            transform: translate(-50%, -50%) scale(1.3);
            opacity: 0.8;
        }
    }

    /* Floating Medical Icons */
    .floating-medical-icon {
        position: absolute;
        font-size: 120px;
        color: rgba(255, 255, 255, 0.05);
        right: 10%;
        top: -20px;
        z-index: -1;
        transform: rotate(-15deg);
        animation: floatIcon 8s infinite ease-in-out;
    }

    .floating-medical-icon.icon-2 {
        font-size: 80px;
        left: 5%;
        bottom: -10px;
        top: auto;
        animation: floatIcon 10s infinite reverse ease-in-out;
    }

    @keyframes floatIcon {

        0%,
        100% {
            transform: translateY(0) rotate(-15deg);
        }

        50% {
            transform: translateY(-30px) rotate(5deg);
        }
    }

    /* Button and Icon Pulse */
    .btn-help-premium {
        background-color: #ffb703;
        color: #000 !important;
        padding: 16px 40px;
        border-radius: 50px;
        font-size: 1.15rem;
        transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        border: 2px solid transparent;
    }

    .btn-help-premium:hover {
        background-color: transparent;
        color: #ffb703 !important;
        border-color: #ffb703;
        transform: scale(1.08);
    }

    .pulse-icon {
        animation: heartBeat 1.2s infinite;
    }

    @keyframes heartBeat {

        0%,
        100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.2);
        }
    }
</style>

    
    <style>
    /* Review Section Base */
    .review-section {
