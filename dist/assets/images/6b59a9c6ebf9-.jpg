<style>
    /* বর্ডার ও কন্টেইনার */
    .border-top-premium {
        border-top: 5px solid #0a2d1e !important;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05) !important;
    }

    /* Left Aligned Step Card */
    .q-card-step {
        padding: 15px;
        background: #f9fafb;
        border-radius: 20px;
        margin-bottom: 15px;
        transition: 0.3s ease;
        border-left: 4px solid transparent;
    }

    .q-card-step:hover {
        background: #ffffff;
        border-left-color: #198754;
        transform: translateX(10px);
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
    }

    .q-logo-wrapper {
        width: 65px;
        height: 65px;
        background: #fff;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        flex-shrink: 0;
    }

    /* Typography Updates */
    .institution-name {
        font-size: 1.15rem;
        line-height: 1.2;
        color: #0a2d1e !important;
