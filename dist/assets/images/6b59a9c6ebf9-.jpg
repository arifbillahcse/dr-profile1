<style>
    .luxury-degree-badge {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.15);
        padding: 6px 16px;
        border-radius: 50px;
        display: flex;
        align-items: center;
        transition: all 0.3s ease;
        backdrop-filter: blur(5px);
    }

    .luxury-degree-badge:hover {
        background: rgba(255, 183, 3, 0.1);
        /* Gold tint on hover */
        border-color: #ffb703;
        transform: translateY(-2px);
    }

    .degree-text {
        color: #f8f9fa;
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 0.3px;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    }

    /* মোবাইলে যাতে কলাপস না করে সুন্দর দেখায় */
    @media (max-width: 991px) {
        .luxury-degree-badge {
            padding: 4px 12px;
        }

        .degree-text {
            font-size: 0.75rem;
            text-align:left;
        }
    }

    .hero-section {
        background: linear-gradient(135deg, #0a2d1e 0%, #051911 100%);
        padding: 100px 0;
        min-height: 85vh;
        display: flex;
        align-items: center;
        color: #ffffff;
        padding-top: 200px;
    }

    /* Background Shapes */
    .hero-bg-shapes .shape {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        z-index: 1;
    }

    .shape-1 {
        width: 350px;
        height: 350px;
        background: rgba(25, 135, 84, 0.2);
        top: -5%;
        right: -5%;
    }

    .shape-2 {
        width: 450px;
        height: 450px;
        background: rgba(255, 183, 3, 0.05);
        bottom: -10%;
        left: -5%;
    }

    /* Doctor Branding */
    .doctor-name {
        font-weight: 800;
        line-height: 1.1;
        text-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    }

    .medical-badge {
        background: rgba(255, 255, 255, 0.1) !important;
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 10px 20px !important;
        border-radius: 50px !important;
        color: #fff !important;
    }

    /* Slider Styling */
    .hero-img {
        height: 520px;
        width: 100%;
        object-fit: cover;
        border-radius: 30px;
    }

    .slide-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 40%;
        background: linear-gradient(to top, rgba(10, 45, 30, 0.9), transparent);
        z-index: 1;
    }

    /* Buttons */
    .btn-appointment-luxury {
        background: #ffb703;
        color: #0a2d1e !important;
        font-weight: 800;
        border-radius: 50px;
        transition: all 0.4s ease;
        border: none;
    }

    .btn-appointment-luxury:hover {
        background: #ffffff;
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(255, 183, 3, 0.4);
    }

    .btn-outline-gold {
        border: 2px solid #ffb703;
        color: #ffb703 !important;
    }

    /* Trust Card */
    .trust-card-luxury {
        position: absolute;
        bottom: -20px;
        left: -30px;
        background: #ffffff;
        padding: 18px 25px;
        border-radius: 20px;
        z-index: 10;
        border-bottom: 5px solid #ffb703;
    }

    .avatar-item {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 2px solid #fff;
        margin-left: -12px;
    }

    .count-badge-luxury {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #ffb703;
        color: #0a2d1e;
        font-size: 14px;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #fff;
        margin-left: -12px;
    }

    /* Animations */
    @keyframes ring {

        0%,
        100% {
            transform: rotate(0);
        }

        10%,
        30%,
        50% {
            transform: rotate(-15deg);
        }

        20%,
        40%,
        60% {
            transform: rotate(15deg);
        }
    }

    .animate-phone {
        animation: ring 1.5s infinite ease-in-out;
    }

    @keyframes bounceSlow {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-15px);
        }
    }

    .animate-bounce-slow {
        animation: bounceSlow 3s infinite ease-in-out;
    }

    /* Mobile Responsive */
    @media (max-width: 991px) {
        .hero-section {
            padding: 60px 0;
            text-align: center;
        }

        .hero-img {
            height: 350px;
        }

        .hero-buttons .btn {
            width: 48%;
            font-size: 13px;
        }

        .trust-card-luxury {
            position: relative;
            left: 0;
            bottom: 0;
            margin: 30px auto 0;
            display: inline-block;
        }
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
    }
</style>

    
