<style>
    /* Base Header Setup */
    .main-header-area {
        width: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1000;
    }

    .header-top-bar {
        background: rgba(10, 45, 30, 0.5);
        padding: 10px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(5px);
    }

    /* Social Icons Style */
    .social-glass-icon {
        width: 32px;
        height: 32px;
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.4s;
        border: 1px solid rgba(255, 255, 255, 0.2);
        font-size: 14px;
    }

    .social-glass-icon:hover {
        background: #ffb703;
        color: #0a2d1e;
        transform: translateY(-3px) rotate(360deg);
        box-shadow: 0 0 15px #ffb703;
    }

    /* Navigation Area */
    .header-navigation-main {
        padding: 20px 0;
        transition: 0.4s ease;
    }

    /* Sticky Effect (Used by your jQuery) */
    .header-sticky.sticky {
        position: fixed !important;
        top: 0;
        width: 100%;
        background: rgba(10, 45, 30, 0.98) !important;
        padding: 12px 0 !important;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        z-index: 9999;
        animation: slideInHeader 0.5s both;
    }

    @keyframes slideInHeader {
        from {
            transform: translateY(-100%);
        }

        to {
            transform: translateY(0);
        }
    }

    /* Menu Link Animation */
    .luxury-menu li {
        margin: 0 18px;
    }

    .luxury-menu li a {
        color: #fff;
        font-weight: 700;
        text-decoration: none;
        font-size: 15px;
        position: relative;
        padding: 10px 0;
        transition: 0.3s;
    }

    .luxury-menu li a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background: #ffb703;
        transition: 0.4s;
        box-shadow: 0 0 10px #ffb703;
    }

    .luxury-menu li a:hover::after,
    .luxury-menu li a.active::after {
        width: 100%;
    }

    .luxury-menu li a:hover,
    .luxury-menu li a.active {
        color: #ffb703;
    }

    /* Neon Call Button */
    .btn-call-neon {
        background: #ffb703;
        color: #0a2d1e !important;
        padding: 10px 22px;
        border-radius: 50px;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 0 15px rgba(255, 183, 3, 0.3);
        transition: 0.4s;
    }

    .btn-call-neon:hover {
        transform: scale(1.05);
        box-shadow: 0 0 25px rgba(255, 183, 3, 0.6);
    }

    /* Phone Shake Animation */
    .phone-shake {
        animation: shake 2s infinite;
    }

    @keyframes shake {

        0%,
        100% {
            transform: rotate(0);
        }

        10%,
        30%,
        50% {
            transform: rotate(-15deg);
        }

        20%,
        40%,
        60% {
            transform: rotate(15deg);
        }
    }

    /* Mobile View Responsive Fix */
    @media (max-width: 991px) {
        .main-header-area {
            position: relative;
            background: #0a2d1e;
        }

        .header-navigation-main {
            padding: 12px 0;
        }

        .main-logo-img {
            height: 40px !important;
        }

        .mobile-nav-toggle {
            background: none;
            border: none;
            color: #ffb703;
            font-size: 24px;
        }
    }

    .main-logo-img {
        height: 60px;
        transition: 0.4s;
        width: auto;
    }

    .sticky .main-logo-img {
        height: 45px;
    }

    /* Mobile Canvas Sidebar */
    .luxury-mobile-canvas {
        background: #0a2d1e;
        width: 280px !important;
    }

    .mobile-nav-links li a {
        color: #fff;
        font-size: 18px;
        font-weight: 600;
        padding: 15px 0;
        display: block;
        text-decoration: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }
</style>

